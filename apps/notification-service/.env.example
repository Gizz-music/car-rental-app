RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Local development: Mailpit from docker-compose (UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# true for port 465 (implicit TLS)
SMTP_SECURE=false
# Required by real SMTP providers, not needed for Mailpit
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Car Rental <no-reply@car-rental.local>"

# Письмо пишет модель (тема и вступление). Без ключа и без LLM_BASE_URL уходит шаблон.
# OpenAI-совместимый API: OpenAI, OpenRouter или локальный Ollama (/v1).
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=8000
