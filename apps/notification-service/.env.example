RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Local development: Mailpit from docker-compose (UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# true for port 465 (implicit TLS)
SMTP_SECURE=false
# Required by real SMTP providers, not needed for Mailpit
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Car Rental <no-reply@car-rental.local>"
